rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isAuthorizedEmail() {
      return isSignedIn() && 
        request.auth.token.email != null && 
        (request.auth.token.email.lower() == 'movieboxproapk007711@gmail.com' ||
         request.auth.token.email.lower() == 'adityaantil260@gmail.com' ||
         request.auth.token.email.lower() == 'amandabasladpuriya@gmail.com');
    }

    function isAdmin() { 
      return isSignedIn() && 
        (request.auth.token.admin == true || isAuthorizedEmail());
    }

    // Movies collection - Anyone can browse and watch movies/series, admins can publish
    match /movies/{movieId} {
      allow read, write: if true;
    }

    // Announcements collection - Anyone can receive updates & releases
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Admins collection - Manage admin records
    match /admins/{uid} {
      allow read, write: if true;
    }
  }
}
