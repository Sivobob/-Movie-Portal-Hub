rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Movies collection - Public read for all users, write allowed for Admin Panel operations & view count updates
    match /movies/{movieId} {
      allow read, write: if true;
    }

    // Announcements collection - Public read and updates for new releases
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Admins collection - Manage admin records
    match /admins/{uid} {
      allow read, write: if true;
    }

    // Remote app configuration (e.g. android_update) - Public read for APK version check, admin write
    match /app_config/{configId} {
      allow read, write: if true;
    }

    // App installed active devices tracking
    match /app_installs/{deviceId} {
      allow read, write: if true;
    }

    // User preferences, watch history, and My List
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // Content reports submitted by users
    match /reports/{reportId} {
      allow read, write: if true;
    }
  }
}
