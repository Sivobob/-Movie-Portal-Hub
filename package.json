{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.js",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:vite --external:express --external:firebase --external:firebase-admin --external:telegram --external:big-integer --external:fluent-ffmpeg --external:dotenv --external:@google/genai",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "assets": "capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.3",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "fluent-ffmpeg": "^2.1.3",
    "hls.js": "^1.7.4",
    "lucide-react": "^0.474.0",
    "motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "telegram": "^2.26.22",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
